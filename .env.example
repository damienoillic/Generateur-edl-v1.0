# Clé API Mistral pour l'analyse vision des photos (modèle pixtral-12b)
# Obtenez votre clé sur https://console.mistral.ai/
MISTRAL_API_KEY=votre_clé_api_ici

# Dossier synchronisé Google Drive (Source de vérité et revue)
# EDL_SYNCED_DRIVE_DIRECTORY=G:\Mon Drive\EDL tool
# EDL_REVIEW_DIRECTORY=G:\Mon Drive\EDL tool\edl-review
# EDL_PROPERTY_INVENTORY_DIRECTORY=G:\Mon Drive\EDL tool

# Dossier source des photos sur le PC (Proton Drive)
# EDL_PHOTOS_SOURCE_ROOT=C:\Users\damie\Proton Drive\damienoillic\My files\EDL

# Serveur MCP local appelé par Mistral Vibe Work (Optionnel si vous utilisez la revue Drive)
EDL_MCP_TOKEN=CHANGE_ME_SECRET_32_CHARS_MINIMUM
EDL_PHOTOS_ROOT=C:\Projet_EDL
EDL_MCP_PORT=3333

# Configuration Chrome / Puppeteer pour la génération PDF
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

